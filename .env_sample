# Database
DATABASE_URL="postgresql://pctrl_user:password@localhost:5432/pctrl?schema=public"
PORT=4000

# Tapo Smart Plug Credentials
TAPO_EMAIL="your-tapo-email@example.com"
TAPO_PASSWORD="your-tapo-password"

# Target Workstation SSH Configuration
TARGET_PC_IP="192.168.1.100"
TARGET_PC_SSH_USER="pctrl-svc"
TARGET_PC_SSH_KEY_PATH="/home/user/.ssh/pctrl_key"
SHUTDOWN_TIMER_MS=120000

# Authentication & Sessions
JWT_SECRET="your-high-entropy-jwt-secret"
JWT_EXPIRY="15m"
COOKIE_AGE=900000
FRONTEND_ORIGIN="http://localhost:3000"

# Dynamic Workspace Settings
CODE_SERVER_TARGET_USER="workstation-user"
PORT_RANGE_START=8100
PORT_RANGE_END=8200

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# ESP32 Integration
ESP32_API_URL="http://energymonitor.local:80"
ESP32_SECRET_KEY="your-esp32-secret-key"

# Sunshine Remote Desktop Configuration
SUNSHINE_WAYLAND_DISPLAY="wayland-0"
SUNSHINE_XDG_RUNTIME_DIR="/run/user/1000"
SUNSHINE_WEB_USER="sunshine-user"
SUNSHINE_WEB_PASS="sunshine-password"