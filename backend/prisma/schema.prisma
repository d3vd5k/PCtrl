// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}




enum Role{
  USER
  ADMIN
  ROOT
}

enum Access {
  PENDING
  GRANTED
  SUSPENDED
  REJECTED
}

enum Power_action{
  MAINS_CONNECTED
  MAINS_CUT
  BOOT_STARTED
  BOOT_COMPLETE
  SHUTDOWN_NORMAL
  SHUTDOWN_FORCED
}

enum Operation{
  NO_OPERATION
  BOOT
  SHUTDOWN
  PLUG_CUT
}

enum ServiceType {
  CODE_SERVER
  SUNSHINE
}

enum ServiceStatus {
  STARTING
  RUNNING
  STOPPED
  FAILED
}

enum Session_status {
  ACTIVE
  TERMINATED
}

enum ESP_STATUS {
  NORMAL
  BROWNOUT
  POWERCUT
}



model User{
  user_id String @id @default(uuid())
  name String
  email String @unique
  role Role @default(USER)
  access Access @default(PENDING)
  password_hash String?
  created_at DateTime @default(now())
  power_events Power_event[]
  sessions Session[]
  password_reset_tokens Password_reset_token[]
}

model Plug{
  plug_id String @id @default(uuid())
  name String
  ip_address String
  mac_address  String   @unique
  plug_identifier String?
  power_events Power_event[]
}

model Power_event{
  event_id String @id @default(uuid())
  event_type Power_action
  user_id String?
  user User? @relation(fields: [user_id], references:[user_id])
  plug_id String
  plug Plug @relation(fields: [plug_id], references: [plug_id])
  timestamp DateTime @default(now())
  description String?
}

model Pc_lock{
  lock_id Int @unique @default(autoincrement())
  operation Operation
  power_cut_at DateTime?
}

model Session {
  session_id String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [user_id])
  status     Session_status @default(ACTIVE)
  started_at DateTime @default(now())
  ended_at   DateTime?
  services   Session_service[]
}

model Session_service {
  service_id   String   @id @default(uuid())
  session_id   String
  session      Session  @relation(fields: [session_id], references: [session_id])
  service_type ServiceType
  port         Int
  password     String   // per-session random, plaintext by necessity — code-server needs it verbatim for auto-login
  pid          Int?
  status       ServiceStatus @default(STARTING)
  started_at   DateTime @default(now())
  stopped_at   DateTime?
}

model Password_reset_token {
  token_id   String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [user_id])
  token_hash String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
}

model Grid_status {
  status_id Int @unique @default(autoincrement())
  status    ESP_STATUS @default(NORMAL)
  updated_at DateTime @updatedAt
}

model Sunshine_status {
  status_id  Int      @unique @default(autoincrement())
  running    Boolean  @default(false)
  pid        Int?
  started_at DateTime?
}